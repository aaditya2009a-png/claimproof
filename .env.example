# Copy this file to .env.local and fill in the values. NEVER commit .env.local.

# --- Supabase ---
# Supabase dashboard -> Project Settings -> API (or "API Keys").
NEXT_PUBLIC_SUPABASE_URL=
# The "anon" (legacy) key OR the "publishable" key. Safe for the browser because Row Level Security protects the data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SECRET. The "service_role" (legacy) or "secret" key. Server-only: used just to record AI review results.
# Never prefix with NEXT_PUBLIC_, never commit it, never paste it into chat.
SUPABASE_SERVICE_ROLE_KEY=

# --- AI provider (server-side only) ---
AI_PROVIDER=gemini
# Create a free key in Google AI Studio (aistudio.google.com). No billing needed for the free tier.
GEMINI_API_KEY=
# Model name. Check the model list in AI Studio; if rate-limited try gemini-3.5-flash-lite.
AI_MODEL=gemini-3.8-flash
# Optional limits
AI_TIMEOUT_MS=45000
REVIEW_CONTEXT_CHAR_BUDGET=24000
